<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatShell" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 允许内容画进刘海/挖孔区。不设这项时，部分 ROM 会把状态栏那一条留成
             黑边（看着就像"应用没盖住系统状态栏"）。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 主题层先把状态栏收掉；onCreate / onResume 里再用 insets 把导航栏一起收 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 万一某些 ROM 硬要露出一条状态栏，就让图标用深色：
             本应用是浅色界面，深色图标才看得清（配合 MainActivity 的
             isAppearanceLightStatusBars = true）。 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
